# ─── Required for live data ──────────────────────────────────────────────
# Apify API token: https://console.apify.com/settings/integrations
# Without it the website runs in Demo mode with fictional sample data.
APIFY_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────────
# Which Apify actor scrapes the Meta Ads Library (default shown).
APIFY_ACTOR_ID=apify~facebook-ads-scraper

# Password for LIVE searches only (they spend your Apify credit). Sample data stays open to everyone.
# Leave empty on your own laptop to search without a password.
LIVE_SEARCH_PASSWORD=

# Lock the WHOLE site behind a password (any username works). Usually leave empty.
SITE_PASSWORD=

# Public URL of the site, used for link previews. Vercel fills this in automatically.
NEXT_PUBLIC_SITE_URL=
